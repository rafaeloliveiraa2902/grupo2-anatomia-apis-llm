{
  "info": {
    "name": "Grupo 2 · Anatomia das APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Mesma pergunta e instrução. Configure os segredos apenas localmente; não exporte variáveis com valores."
  },
  "variable": [
    {
      "key": "openai_api_key",
      "value": ""
    },
    {
      "key": "anthropic_api_key",
      "value": ""
    },
    {
      "key": "openai_model",
      "value": "gpt-4.1-mini"
    },
    {
      "key": "anthropic_model",
      "value": "claude-haiku-5-5"
    }
  ],
  "item": [
    {
      "name": "01 · OpenAI — Responses",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{openai_api_key}}",
            "type": "text"
          }
        ],
        "url": "https://api.openai.com/v1/responses",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"{{openai_model}}\",\n  \"instructions\": \"Responda em português, com clareza, em até 120 palavras. Use um exemplo de aplicação web.\",\n  \"input\": \"O que é uma API? Explique com um exemplo de aplicação web.\",\n  \"max_output_tokens\": 600,\n  \"store\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 · Anthropic — Messages",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "x-api-key",
            "value": "{{anthropic_api_key}}",
            "type": "text"
          },
          {
            "key": "anthropic-version",
            "value": "2023-06-01",
            "type": "text"
          }
        ],
        "url": "https://api.anthropic.com/v1/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"{{anthropic_model}}\",\n  \"system\": \"Responda em português, com clareza, em até 120 palavras. Use um exemplo de aplicação web.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"O que é uma API? Explique com um exemplo de aplicação web.\"\n    }\n  ],\n  \"max_tokens\": 600\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 · Comparador local (sem chaves no Postman)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://127.0.0.1:3000/api/compare",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"O que é uma API? Explique com um exemplo de aplicação web.\",\n  \"mode\": \"live\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}